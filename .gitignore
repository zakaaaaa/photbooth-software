# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Flutter desktop ephemeral build artifacts (regenerated by `flutter build`) ---
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/
windows/flutter/generated_plugin*
linux/flutter/generated_plugin*
macos/Flutter/GeneratedPluginRegistrant.swift

# --- Local machine / editor / agent config (never commit: holds local credentials) ---
.claude/
.vscode/settings.json

# --- Unrelated side projects & scratch files ---
hire-mail-bot/
d.html

# --- Camera / capture output ---
assets/frames/*.png
*.tmp
assets/bin/ffmpeg.exe
